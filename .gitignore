# ==================================================================
# Exceptions (files to keep)
# ==================================================================

# Keep these specific files
!.gitignore
!README.md
!requirements.txt
!app_config.json
!config/app_config.json
!config/theme_config.json

# Keep sample/template files
!**/*.template.*
!**/*.sample.*
!**/*.example.*

# Keep help files
!resources/help_en.html
!resources/help_fa.html

# Keep empty directories
!.gitkeep